generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Utilisateur {
  id                    String         @id @default(cuid())
  telephone             String?        @unique
  nom                   String
  role                  Role           @default(AGRICULTEUR)
  commune               String
  region                Region
  orangeMoney           String?
  photoUrl              String?
  actif                 Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  email                 String?        @unique
  passwordHash          String?
  animaux               Animal[]
  avisDonnes            Avis[]         @relation("AuteurAvis")
  avisRecus             Avis[]         @relation("DestinataireAvis")
  achats                Commande[]     @relation("AcheteurCommandes")
  ventes                Commande[]     @relation("VendeurCommandes")
  conversationsEntamees Conversation[] @relation("AcheteurConversations")
  conversationsRecues   Conversation[] @relation("VendeurConversations")
  locations             Location[]
  materiels             Materiel[]
  messagesEnvoyes       Message[]      @relation("ExpediteurMessages")
  portefeuille          Portefeuille?
  produits              Produit[]      @relation("AgriculteurProduits")
  retraits              Retrait[]

  @@map("utilisateurs")
}

model Produit {
  id            String         @id @default(cuid())
  type          TypeProduit
  quantiteKg    Float
  prixFcfa      Int
  description   String?
  photoUrl      String?
  disponible    Boolean        @default(true)
  commune       String
  region        Region
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  agriculteurId String
  latitude      Float?
  longitude     Float?
  commandes     Commande[]
  conversations Conversation[]
  agriculteur   Utilisateur    @relation("AgriculteurProduits", fields: [agriculteurId], references: [id])

  @@index([region, disponible])
  @@index([type])
  @@map("produits")
}

model Commande {
  id             String         @id @default(cuid())
  quantiteKg     Float
  montantFcfa    Int
  commission     Int
  statut         StatutCommande @default(EN_ATTENTE)
  paiementRef    String?
  paiementStatut String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  produitId      String
  acheteurId     String
  vendeurId      String
  avis           Avis?
  acheteur       Utilisateur    @relation("AcheteurCommandes", fields: [acheteurId], references: [id])
  produit        Produit        @relation(fields: [produitId], references: [id])
  vendeur        Utilisateur    @relation("VendeurCommandes", fields: [vendeurId], references: [id])

  @@map("commandes")
}

model Materiel {
  id             String         @id @default(cuid())
  type           TypeMateriel
  description    String?
  prixJour       Int
  caution        Int
  photoUrl       String?
  disponible     Boolean        @default(true)
  commune        String
  region         Region
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  proprietaireId String
  latitude       Float?
  longitude      Float?
  conversations  Conversation[]
  locations      Location[]
  proprietaire   Utilisateur    @relation(fields: [proprietaireId], references: [id])

  @@index([region, disponible])
  @@index([type])
  @@map("materiels")
}

model Location {
  id            String         @id @default(cuid())
  dateDebut     DateTime
  dateFin       DateTime
  montantFcfa   Int
  commission    Int
  caution       Int
  statut        StatutLocation @default(EN_ATTENTE)
  paiementRef   String?
  contratPdfUrl String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  materielId    String
  locataireId   String
  avis          Avis?
  locataire     Utilisateur    @relation(fields: [locataireId], references: [id])
  materiel      Materiel       @relation(fields: [materielId], references: [id])

  @@map("locations")
}

model Animal {
  id            String         @id @default(cuid())
  type          TypeAnimal
  race          String?
  age           Int?
  poidsKg       Float?
  prixFcfa      Int
  description   String?
  photoUrl      String?
  vendu         Boolean        @default(false)
  commune       String
  region        Region
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vendeurId     String
  latitude      Float?
  longitude     Float?
  vendeur       Utilisateur    @relation(fields: [vendeurId], references: [id])
  conversations Conversation[]

  @@index([region, vendu])
  @@index([type])
  @@map("animaux")
}

model PrixMarche {
  id      String      @id @default(cuid())
  produit TypeProduit
  region  Region
  prixKg  Int
  source  String?
  date    DateTime    @default(now())

  @@unique([produit, region, date])
  @@map("prix_marche")
}

model Otp {
  id        String   @id @default(cuid())
  telephone String
  code      String
  expiresAt DateTime
  utilise   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otps")
}

model Portefeuille {
  id            String                    @id @default(cuid())
  solde         Int                       @default(0)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  utilisateurId String                    @unique
  utilisateur   Utilisateur               @relation(fields: [utilisateurId], references: [id])
  transactions  TransactionPortefeuille[]

  @@map("portefeuilles")
}

model TransactionPortefeuille {
  id             String          @id @default(cuid())
  montant        Int
  type           TypeTransaction
  referenceId    String?
  createdAt      DateTime        @default(now())
  portefeuilleId String
  portefeuille   Portefeuille    @relation(fields: [portefeuilleId], references: [id])

  @@map("transactions_portefeuille")
}

model Retrait {
  id            String        @id @default(cuid())
  montant       Int
  numeroPhone   String
  statut        StatutRetrait @default(EN_ATTENTE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  utilisateurId String
  utilisateur   Utilisateur   @relation(fields: [utilisateurId], references: [id])

  @@map("retraits")
}

model Conversation {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  acheteurId String
  vendeurId  String
  produitId  String?
  animalId   String?
  materielId String?
  acheteur   Utilisateur @relation("AcheteurConversations", fields: [acheteurId], references: [id])
  animal     Animal?     @relation(fields: [animalId], references: [id])
  materiel   Materiel?   @relation(fields: [materielId], references: [id])
  produit    Produit?    @relation(fields: [produitId], references: [id])
  vendeur    Utilisateur @relation("VendeurConversations", fields: [vendeurId], references: [id])
  messages   Message[]

  @@unique([acheteurId, vendeurId, produitId])
  @@unique([acheteurId, vendeurId, animalId])
  @@unique([acheteurId, vendeurId, materielId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  expediteurId   String
  type           TypeMessage  @default(TEXTE)
  contenu        String?
  audioUrl       String?
  lu             Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  expediteur     Utilisateur  @relation("ExpediteurMessages", fields: [expediteurId], references: [id])

  @@map("messages")
}

model Avis {
  id             String      @id @default(cuid())
  note           Int
  commentaire    String?
  createdAt      DateTime    @default(now())
  auteurId       String
  destinataireId String
  commandeId     String?     @unique
  locationId     String?     @unique
  auteur         Utilisateur @relation("AuteurAvis", fields: [auteurId], references: [id])
  commande       Commande?   @relation(fields: [commandeId], references: [id])
  destinataire   Utilisateur @relation("DestinataireAvis", fields: [destinataireId], references: [id])
  location       Location?   @relation(fields: [locationId], references: [id])

  @@map("avis")
}

enum Role {
  AGRICULTEUR
  ACHETEUR
  BOUTIQUE
  ADMIN
}

enum Region {
  BAMAKO
  KAYES
  KOULIKORO
  SIKASSO
  SEGOU
  MOPTI
  TOMBOUCTOU
  GAO
  KIDAL
  MENAKA
  TAOUDENIT
}

enum TypeProduit {
  MIL
  SORGHO
  MAIS
  RIZ
  ARACHIDE
  NIEBE
  SESAME
  COTON
  MANGUE
  OIGNON
  TOMATE
  KARITE
  GOMBO
  PATATE_DOUCE
  IGNAME
}

enum StatutCommande {
  EN_ATTENTE
  PAIEMENT_INITIE
  PAYE
  EN_COURS
  LIVRE
  ANNULE
}

enum TypeMateriel {
  TRACTEUR
  MOTOPOMPE
  BATTEUSE
  CHARRUE
  SEMOIR
  SILO
  REMORQUE
  PULVERISATEUR
  MOISSONNEUSE
}

enum StatutLocation {
  EN_ATTENTE
  CAUTION_BLOQUEE
  EN_COURS
  TERMINE
  ANNULE
}

enum TypeAnimal {
  BOEUF
  MOUTON
  CHEVRE
  VOLAILLE
  PORC
  ANE
  CHEVAL
  CHAMEAU
}

enum TypeTransaction {
  VENTE
  LOCATION
  RETRAIT
}

enum StatutRetrait {
  EN_ATTENTE
  VALIDE
  REJETE
}

enum TypeMessage {
  TEXTE
  VOCAL
}
