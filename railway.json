{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pwd && ls && npm install && npx prisma generate && npx tsc",
    "watchPatterns": ["backend/**"]
  },
  "deploy": {
    "startCommand": "node dist/server.js",
    "restartPolicyType": "ON_FAILURE",
    "root": "backend"
  }
}
