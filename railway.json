{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend && npm install --omit=dev",
    "watchPatterns": ["backend/**"]
  },
  "deploy": {
    "startCommand": "node backend/dist/server.js",
    "restartPolicyType": "ON_FAILURE"
  }
}
